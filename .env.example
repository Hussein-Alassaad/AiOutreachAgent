# =============================================================================
# NEXARIS AI OUTREACH AGENT — environment variables
# =============================================================================
# This file is committed and contains NO real secrets. Copy the relevant section
# into agent/.env and dashboard/.env, then fill in real values. Those two files
# are gitignored and must never be committed.
#
#   cp .env.example agent/.env
#   cp .env.example dashboard/.env
#
# The "needed by" note on each block tells you which phase actually requires it —
# you do not need everything filled in to start.
# =============================================================================


# -----------------------------------------------------------------------------
# AGENT (agent/.env) — the Python agent, runs on the always-on server
# -----------------------------------------------------------------------------

# --- Database --- needed by: Phase 1 --- PORTED 2026-08-20 ---
# The agent no longer has its own standalone Supabase project. It now reads and
# writes the SAME multi-tenant Postgres database as the main Next.js SaaS app --
# set this to the EXACT SAME value as that app's own DATABASE_URL (repo root
# .env), not a separate database. That's the Supabase Postgres connection
# string, transaction pooler, e.g.:
#   postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
# The agent uses a real connection pool (db/postgres_client.py) sized for a
# long-running scheduler process, not a web server -- see that module's
# docstring for why psycopg2 + ThreadedConnectionPool was chosen. Every query
# is tenant-scoped (WHERE tenant_id = ...) -- see db/repositories.py.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host:6543/postgres?pgbouncer=true

# --- Outreach encryption key --- needed by: proxy password decryption ---
# Must be the EXACT SAME value as the Next.js app's own OUTREACH_ENCRYPTION_KEY
# (32 bytes, base64-encoded, e.g. `openssl rand -base64 32`). The dashboard
# encrypts each account's proxy password with this key (AES-256-GCM, see
# src/lib/outreach/crypto.ts); the agent only ever decrypts, never encrypts
# (see db/crypto.py), right before handing a proxy password to Playwright.
OUTREACH_ENCRYPTION_KEY=

# --- Claude API --- needed by: Phase 4 ---
# From console.anthropic.com. Haiku handles analysis/scoring/founder detection
# (high volume, cost-efficient); Sonnet writes the messages (better quality).
ANTHROPIC_API_KEY=
MODEL_ANALYSIS=claude-haiku-4-5-20251001
MODEL_MESSAGES=claude-sonnet-5

# --- WhatsApp --- needed by: Phase 7 (sending) and Phase 8 (notifications) ---
# Provider not finalised yet — see open decision Q1 in REQUIREMENTS_COVERAGE.md.
WHATSAPP_PROVIDER=twilio
WHATSAPP_API_KEY=
WHATSAPP_API_SECRET=
WHATSAPP_FROM_NUMBER=

# --- Findymail --- needed by: agent/discovery/findymail.py ---
# Email lookup for LinkedIn-discovered companies' decision-makers. Without
# this set, email-lead creation from LinkedIn discovery silently no-ops
# (FindymailNotConfigured, caught and skipped) -- everything else keeps
# working. Get a key at https://findymail.com after signing up.
FINDYMAIL_API_KEY=

# --- Runtime --- needed by: Phase 2 ---
# Timezone that each account's run time is interpreted in.
TIMEZONE=Asia/Beirut
# HEADLESS=false shows a visible browser — useful while building discovery in
# Phase 3. Must be true on the server.
HEADLESS=true
# Safety brake for local testing: caps leads per account regardless of the
# dashboard setting. Leave empty in production.
DEV_MAX_LEADS_PER_ACCOUNT=

# --- Proxies --- needed by: Phase 10 ---
# NOTE: proxy credentials are stored PER ACCOUNT in the outreach_accounts table
# (proxy_host/proxy_port/proxy_username/proxy_password_enc) and edited from the
# Next.js app's Account Health page (src/app/(outreach)/outreach/accounts/) —
# not here. Listed only so you know where they live. Each account gets one
# dedicated sticky residential IP, never shared, and rotating or datacenter
# proxies must never be used. proxy_password_enc is AES-256-GCM ciphertext (see
# OUTREACH_ENCRYPTION_KEY above) -- the agent decrypts it, never the reverse.


# -----------------------------------------------------------------------------
# DASHBOARD (dashboard/.env) — the standalone React PWA
# -----------------------------------------------------------------------------
# SUPERSEDED as of the 2026-08-20 multi-tenant port: this standalone Vite/React
# dashboard talked to the old single-tenant Supabase project directly and is not
# part of this port's scope. The real, current UI for Outreach is the Next.js
# app itself (src/app/(outreach)/outreach/*, e.g. AccountHealthClient.tsx),
# which reads/writes the same Postgres database as agent/.env above via Prisma
# -- no separate dashboard .env is needed for that UI. This section is left as
# historical reference only; the standalone dashboard/ folder was never wired
# to the multi-tenant schema.
#
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=
